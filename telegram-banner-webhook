import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type, range, x-telegram-bot-api-secret-token",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS, HEAD",
  "Access-Control-Expose-Headers":
    "Accept-Ranges, Content-Length, Content-Range, Content-Type",
};

function jsonResponse(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store",
    },
  });
}

function getEnv(name: string): string | null {
  const value = Deno.env.get(name);
  return value?.trim() || null;
}

function getSupabase() {
  const url = getEnv("MyDrama_URL");
  const key = getEnv("SERVICE_ROLE_KEY");

  if (!url || !key) {
    throw new Error("Missing MyDrama_URL or SERVICE_ROLE_KEY");
  }

  return createClient(url, key, {
    auth: {
      persistSession: false,
      autoRefreshToken: false,
    },
  });
}

const uuidPattern =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

type BannerMedia = {
  fileId: string;
  uniqueFileId: string | null;
  mediaType: "image" | "video";
};

function extractMedia(post: any): BannerMedia | null {
  if (Array.isArray(post.photo) && post.photo.length > 0) {
    const photo = post.photo[post.photo.length - 1];

    if (typeof photo.file_id === "string" && photo.file_id) {
      return {
        fileId: photo.file_id,
        uniqueFileId: photo.file_unique_id ?? null,
        mediaType: "image",
      };
    }
  }

  if (post.video && typeof post.video.file_id === "string") {
    return {
      fileId: post.video.file_id,
      uniqueFileId: post.video.file_unique_id ?? null,
      mediaType: "video",
    };
  }

  if (post.document && typeof post.document.file_id === "string") {
    const mime = String(post.document.mime_type ?? "").toLowerCase();

    if (mime.startsWith("video/")) {
      return {
        fileId: post.document.file_id,
        uniqueFileId: post.document.file_unique_id ?? null,
        mediaType: "video",
      };
    }

    if (mime.startsWith("image/")) {
      return {
        fileId: post.document.file_id,
        uniqueFileId: post.document.file_unique_id ?? null,
        mediaType: "image",
      };
    }
  }

  return null;
}

function parseCaption(caption: string) {
  const fields: Record<string, string> = {};

  for (const line of caption.split(/\r?\n/)) {
    const match = line.match(
      /^\s*(Banner|Drama ID|Title)\s*:\s*(.*?)\s*$/i,
    );

    if (match) {
      fields[match[1].toLowerCase()] = match[2].trim();
    }
  }

  return {
    bannerNumber: Number(fields["banner"]),
    dramaId: fields["drama id"] ?? "",
    title: fields["title"] ?? "",
  };
}

async function sendTelegramMessage(
  botToken: string,
  chatId: string | number,
  text: string,
  replyToMessageId?: number,
) {
  const payload: Record<string, unknown> = {
    chat_id: chatId,
    text,
  };

  if (replyToMessageId) {
    payload.reply_to_message_id = replyToMessageId;
    payload.allow_sending_without_reply = true;
  }

  try {
    const response = await fetch(
      `https://api.telegram.org/bot${botToken}/sendMessage`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      },
    );

    const result = await response.json().catch(() => null);

    if (!response.ok || !result?.ok) {
      console.error(
        "Telegram sendMessage failed:",
        response.status,
        JSON.stringify(result),
      );
      return false;
    }

    return true;
  } catch (error) {
    console.error("Telegram sendMessage exception:", error);
    return false;
  }
}

/* ---------------- GET: BANNER LIST + MEDIA STREAM ---------------- */

async function handleGet(req: Request): Promise<Response> {
  const url = new URL(req.url);
  const media = url.searchParams.get("media");
  const numberParam = url.searchParams.get("number");

  try {
    const supabase = getSupabase();

    // GET /telegram-banner-webhook
    // Return banner list for the app.
    if (!media) {
      const { data, error } = await supabase
        .from("banners")
        .select(
          "banner_number, drama_id, title, media_type, telegram_file_id, telegram_file_unique_id, created_at, updated_at",
        )
        .order("banner_number", { ascending: true });

      if (error) {
        console.error("Banner list query failed:", error.message);
        return jsonResponse(
          { success: false, error: "Could not fetch banners" },
          500,
        );
      }

      const endpoint = `${url.origin}${url.pathname}`;

      const banners = (data ?? []).map((banner) => ({
        banner_number: banner.banner_number,
        drama_id: banner.drama_id,
        title: banner.title,
        media_type: banner.media_type,
        created_at: banner.created_at,
        updated_at: banner.updated_at,
        media_url:
          `${endpoint}?media=banner&number=${banner.banner_number}`,
      }));

      return jsonResponse({ success: true, banners });
    }

    // GET /telegram-banner-webhook?media=banner&number=1
    if (media !== "banner") {
      return jsonResponse(
        { success: false, error: "Unsupported media type" },
        400,
      );
    }

    const bannerNumber = Number(numberParam);

    if (
      !Number.isInteger(bannerNumber) ||
      bannerNumber < 1 ||
      bannerNumber > 5
    ) {
      return jsonResponse(
        { success: false, error: "Invalid banner number" },
        400,
      );
    }

    const { data: banner, error: bannerError } = await supabase
      .from("banners")
      .select("telegram_file_id, media_type, title")
      .eq("banner_number", bannerNumber)
      .maybeSingle();

    if (bannerError) {
      console.error("Banner media lookup failed:", bannerError.message);
      return jsonResponse(
        { success: false, error: "Could not find banner" },
        500,
      );
    }

    if (!banner?.telegram_file_id) {
      return jsonResponse(
        { success: false, error: "Banner media not found" },
        404,
      );
    }

    const botToken = getEnv("TELEGRAM_BANNER_BOT_TOKEN");

    if (!botToken) {
      console.error("Missing TELEGRAM_BANNER_BOT_TOKEN");
      return jsonResponse(
        { success: false, error: "Telegram configuration missing" },
        500,
      );
    }

    // Ask Telegram for the actual file path.
    const fileInfoResponse = await fetch(
      `https://api.telegram.org/bot${botToken}/getFile?file_id=${
        encodeURIComponent(banner.telegram_file_id)
      }`,
    );

    const fileInfo = await fileInfoResponse.json().catch(() => null);

    if (!fileInfoResponse.ok || !fileInfo?.ok) {
      console.error(
        "Telegram getFile failed:",
        fileInfoResponse.status,
        JSON.stringify(fileInfo),
      );

      return jsonResponse(
        { success: false, error: "Telegram could not locate media" },
        502,
      );
    }

    const filePath = fileInfo.result?.file_path;

    if (typeof filePath !== "string" || !filePath) {
      return jsonResponse(
        { success: false, error: "Telegram returned no file path" },
        502,
      );
    }

    const fileUrl =
      `https://api.telegram.org/file/bot${botToken}/${filePath}`;

    const requestHeaders = new Headers();

    // Forward Range requests from ExoPlayer to Telegram.
    const range = req.headers.get("Range");

    if (range) {
      requestHeaders.set("Range", range);
    }

    const upstreamResponse = await fetch(fileUrl, {
      method: req.method === "HEAD" ? "HEAD" : "GET",
      headers: requestHeaders,
      redirect: "follow",
    });

    if (
      !upstreamResponse.ok &&
      upstreamResponse.status !== 206
    ) {
      console.error(
        "Telegram media download failed:",
        upstreamResponse.status,
      );

      await upstreamResponse.body?.cancel();

      return jsonResponse(
        { success: false, error: "Could not download Telegram media" },
        502,
      );
    }

    const headers = new Headers(corsHeaders);

    headers.set(
      "Content-Type",
      upstreamResponse.headers.get("Content-Type") ??
        (banner.media_type === "video" ? "video/mp4" : "image/jpeg"),
    );

    headers.set("Cache-Control", "public, max-age=60");
    headers.set(
      "Accept-Ranges",
      upstreamResponse.headers.get("Accept-Ranges") ?? "bytes",
    );
    headers.set(
      "X-Content-Type-Options",
      "nosniff",
    );

    const contentLength = upstreamResponse.headers.get("Content-Length");
    const contentRange = upstreamResponse.headers.get("Content-Range");

    if (contentLength) {
      headers.set("Content-Length", contentLength);
    }

    if (contentRange) {
      headers.set("Content-Range", contentRange);
    }

    return new Response(
      req.method === "HEAD" ? null : upstreamResponse.body,
      {
        status: upstreamResponse.status,
        headers,
      },
    );
  } catch (error) {
    console.error("GET banner handler failed:", error);

    return jsonResponse(
      { success: false, error: "Banner request failed" },
      500,
    );
  }
}

/* ---------------- POST: SAVE / UPDATE BANNER ---------------- */

async function handlePost(req: Request): Promise<Response> {
  const botToken = getEnv("TELEGRAM_BANNER_BOT_TOKEN");
  const expectedChannel = getEnv("TELEGRAM_BANNER_CHANNEL_ID");
  const webhookSecret = getEnv("TELEGRAM_BANNER_WEBHOOK_SECRET");

  if (!botToken || !expectedChannel) {
    console.error("Missing Telegram bot token or channel ID");

    return jsonResponse(
      { success: false, error: "Server configuration missing" },
      500,
    );
  }

  if (
    webhookSecret &&
    req.headers.get("X-Telegram-Bot-Api-Secret-Token") !== webhookSecret
  ) {
    console.error("Rejected webhook request: invalid secret");

    return jsonResponse(
      { success: false, error: "Unauthorized" },
      401,
    );
  }

  let update: any;

  try {
    update = await req.json();
  } catch (error) {
    console.error("Invalid webhook JSON:", error);

    return jsonResponse({
      success: false,
      ignored: true,
      error: "Invalid JSON",
    });
  }

  const post = update?.channel_post;

  if (!post) {
    return jsonResponse({
      success: true,
      ignored: true,
      reason: "Not a channel post",
    });
  }

  const actualChannel = String(post.chat?.id ?? "");

  if (actualChannel !== String(expectedChannel)) {
    console.error("Ignored post from unexpected channel:", actualChannel);

    return jsonResponse({
      success: false,
      ignored: true,
      error: "Wrong channel",
    });
  }

  const parsed = parseCaption(String(post.caption ?? ""));
  const { bannerNumber, dramaId, title } = parsed;

  if (
    !Number.isInteger(bannerNumber) ||
    bannerNumber < 1 ||
    bannerNumber > 5
  ) {
    await sendTelegramMessage(
      botToken,
      post.chat.id,
      "❌ Banner save nahi hua: caption mein Banner: 1 se 5 tak number likho.",
      post.message_id,
    );

    return jsonResponse({
      success: false,
      ignored: true,
      error: "Invalid banner number",
    });
  }

  if (!title || title.length > 200) {
    await sendTelegramMessage(
      botToken,
      post.chat.id,
      "❌ Banner save nahi hua: Title zaroor likho (maximum 200 characters).",
      post.message_id,
    );

    return jsonResponse({
      success: false,
      ignored: true,
      error: "Invalid title",
    });
  }

  if (!dramaId || !uuidPattern.test(dramaId)) {
    await sendTelegramMessage(
      botToken,
      post.chat.id,
      "❌ Banner save nahi hua: Drama ID mein valid UUID dena zaroori hai.",
      post.message_id,
    );

    return jsonResponse({
      success: false,
      ignored: true,
      error: "Invalid Drama ID",
    });
  }

  const media = extractMedia(post);

  if (!media) {
    await sendTelegramMessage(
      botToken,
      post.chat.id,
      "❌ Banner save nahi hua: post mein supported image ya video nahi mili.",
      post.message_id,
    );

    return jsonResponse({
      success: false,
      ignored: true,
      error: "No supported media",
    });
  }

  try {
    const supabase = getSupabase();

    const { data: drama, error: dramaError } = await supabase
      .from("dramas")
      .select("id")
      .eq("id", dramaId)
      .maybeSingle();

    if (dramaError) {
      console.error("Drama lookup failed:", dramaError.message);

      return jsonResponse({
        success: false,
        error: "Drama lookup failed",
      });
    }

    if (!drama) {
      await sendTelegramMessage(
        botToken,
        post.chat.id,
        `❌ Banner ${bannerNumber} save nahi hua: Drama ID ${dramaId} dramas table mein nahi mili.`,
        post.message_id,
      );

      return jsonResponse({
        success: false,
        ignored: true,
        error: "Drama not found",
      });
    }

    const { data: savedBanner, error: upsertError } = await supabase
      .from("banners")
      .upsert(
        {
          banner_number: bannerNumber,
          drama_id: dramaId,
          title,
          media_type: media.mediaType,
          telegram_file_id: media.fileId,
          telegram_file_unique_id: media.uniqueFileId,
          updated_at: new Date().toISOString(),
        },
        {
          onConflict: "banner_number",
        },
      )
      .select("banner_number, title, media_type, drama_id")
      .single();

    if (upsertError || !savedBanner) {
      console.error("Banner upsert failed:", {
        message: upsertError?.message,
        code: upsertError?.code,
        details: upsertError?.details,
        hint: upsertError?.hint,
        bannerNumber,
        mediaType: media.mediaType,
      });

      return jsonResponse({
        success: false,
        error: "Database save failed",
      });
    }

    console.log("Banner saved successfully:", {
      bannerNumber: savedBanner.banner_number,
      mediaType: savedBanner.media_type,
      messageId: post.message_id,
    });

    await sendTelegramMessage(
      botToken,
      post.chat.id,
      `✅ Banner ${savedBanner.banner_number} successfully save/update ho gaya!\n` +
        `Title: ${savedBanner.title}\n` +
        `Media: ${savedBanner.media_type}`,
      post.message_id,
    );

    return jsonResponse({
      success: true,
      message: "Banner saved successfully",
      banner: savedBanner,
    });
  } catch (error) {
    console.error("Unexpected banner webhook error:", error);

    return jsonResponse({
      success: false,
      error: "Unexpected processing error",
    });
  }
}

/* ---------------- REQUEST ROUTER ---------------- */

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response(null, {
      status: 204,
      headers: corsHeaders,
    });
  }

  if (req.method === "GET" || req.method === "HEAD") {
    return handleGet(req);
  }

  if (req.method === "POST") {
    return handlePost(req);
  }

  return jsonResponse(
    { success: false, error: "Method not allowed" },
    405,
  );
});